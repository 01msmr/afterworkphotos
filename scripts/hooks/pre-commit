#!/bin/sh
# The gallery's version (2026-09-19): MAJOR.MINOR.PATCH in V, gallery/index.html.
# Whenever a gallery file is in the commit the hook counts PATCH up, so a
# module's URL is new with every change and nobody types a version; MAJOR
# and MINOR are set by hand in V when a release deserves it.
# Installed with: git config core.hooksPath scripts/hooks
if git diff --cached --name-only | grep -qE '^(gallery/index\.html|res/gallery\.js|res/gallery/.*\.js)$'; then
	OLD=$(sed -n "s/.*const V = '\([0-9]*\.[0-9]*\.[0-9]*\)'.*/\1/p" gallery/index.html)
	[ -n "$OLD" ] || { echo "gallery: V is not MAJOR.MINOR.PATCH" >&2; exit 1; }
	NEW="${OLD%.*}.$(( ${OLD##*.} + 1 ))"
	sed -i '' "s/const V = '$OLD';/const V = '$NEW';/" gallery/index.html
	git add gallery/index.html
	echo "gallery: $OLD -> $NEW"
fi
